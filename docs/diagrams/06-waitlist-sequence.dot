digraph G {rankdir=TB;graph[bgcolor="white",pad=.25,nodesep=.4,ranksep=.5];node[shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#306284",fontname="Arial",fontsize=12,margin=".18,.12"];edge[fontname="Arial",fontsize=10,color="#526e81"];a[label="1 Student cancels at least two hours before start"];b[label="2 API checks ownership and cutoff"];c[label="3 BEGIN IMMEDIATE"];d[label="4 Cancel booking and select first eligible waiter"];e[label="5 Confirm waiter and create inbox message"];f[label="6 COMMIT together"];a->b->c->d->e->f;}