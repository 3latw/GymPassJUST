# npm start reads the environment supplied by the shell. Never commit a real .env.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Production requires these values and NODE_ENV=production.
# NODE_ENV=production
# DOMAIN=gympass.example.edu
# APP_ORIGIN=https://gympass.example.edu
# OIDC_ISSUER=https://identity.example.edu/realms/gympass
# OIDC_CLIENT_ID=gympass
# OIDC_CLIENT_SECRET=replace-with-provider-secret-if-required
# SIGNING_SECRET=replace-with-a-long-cryptographically-random-value
