{
  "name": "gympass-se440",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "c8 --include=src/** --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --statements=70 node --test tests/*.test.js",
    "test:load": "node scripts/load-test.js",
    "backup": "node scripts/backup.js",
    "check": "node --check src/server.js && node --check src/service.js && node --check public/app.js",
    "build:pages": "node scripts/build-pages.js",
    "check:cloudflare": "node --check cloudflare/worker.js && node --check cloudflare/pages-worker.js && node --check cloudflare/database.js",
    "build:cloudflare": "node scripts/build-cloudflare.js",
    "test:cloudflare": "npm run build:cloudflare && node --test tests/cloudflare.integration.js",
    "deploy:backend": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist-pages --project-name gympassjust --branch main"
  },
  "dependencies": {
    "express": "5.1.0",
    "jose": "6.2.1",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "prettier": "3.6.2",
    "wrangler": "4.156.1"
  }
}
